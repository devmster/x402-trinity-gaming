<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compiles the SIGNER ONLY, outside Unity, so its output can be checked against the golden
    vectors from the TypeScript implementation. The bridge is not here on purpose - it depends
    on UnityEngine and has no cryptography in it.

      dotnet test unity/verify
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>X402.Gaming.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Runtime/X402Signer.cs" />
    <Compile Include="../Tests/X402SignerTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
  </ItemGroup>

</Project>
